# Plantilla para el servidor. Copiar como .env y completar los valores marcados.
# Generar la clave con: php artisan key:generate

APP_NAME=Veterinaria
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
# Dominio raíz de la plataforma (sin subdominio de clínica)
APP_URL=http://162.214.196.37.nip.io

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

# Cada clínica vive en {slug}.TENANCY_CENTRAL_DOMAIN
# Al comprar el dominio definitivo solo se cambia esto y APP_URL
TENANCY_CENTRAL_DOMAIN=162.214.196.37.nip.io

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base de datos creada en cPanel (los nombres llevan el prefijo de la cuenta)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=veterinaria_app
DB_USERNAME=veterinaria_app
DB_PASSWORD=CAMBIAR

# Sin Redis en cPanel: todo en base de datos
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
