# Backend Laravel al que el servidor de Vite redirige /api en desarrollo
VITE_API_PROXY=http://veterinaria-api.test

# Dominio base de la plataforma: la clínica se toma del subdominio ({slug}.app.com)
VITE_CENTRAL_DOMAIN=app.com

# Clínica a usar cuando no hay subdominio (ej. localhost)
VITE_DEFAULT_TENANT=demo
